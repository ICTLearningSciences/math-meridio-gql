{
  "name": "graphql",
  "version": "1.0.0",
  "description": "serverless graphql for math meridio",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "deps:update": "npx ncu -u",
    "deploy:dev": "NODE_OPTIONS=--max_old_space_size=4000 sls deploy -s dev --region us-east-1",
    "deploy:qa": "NODE_OPTIONS=--max_old_space_size=4000 sls deploy -s qa --region us-east-1",
    "deploy:prod": "NODE_OPTIONS=--max_old_space_size=4000 sls deploy -s prod --region us-east-1",
    "format": "prettier --write '**/*.{js,jsx,json,ts,tsx,yml,yaml}'",
    "format-win": "prettier --write \"**/*.{js,jsx,json,ts,tsx,yml,yaml}\"",
    "lint:fix": "eslint . --ext ts --ext js --fix",
    "start": "tsc && node dist/server.js",
    "test": "export ENV=test && export LLM_API_ENDPOINT=test-value && export ABE_SECRET_HEADER_NAME=test-value && export ABE_SECRET_HEADER_VALUE=test-value && export NODE_ENV=test && npx mocha -r tsconfig-paths/register -r ts-node/register -r source-map-support/register './test/**/*.{spec,test}.{js,ts}' --timeout 10000 --full-trace --recursive --reporter spec --delay --exit",
    "test-win": "set ENV=test && set NODE_ENV=test && npx mocha -r tsconfig-paths/register -r ts-node/register -r source-map-support/register './test/**/*.{spec,test}.{js,ts}' --timeout 10000 --full-trace --recursive --reporter spec --delay --exit",
    "test:all": "npm run test:format && npm run test:lint && npm run test:audit && npm run test:types && npm test",
    "test:all-win": "npm run test:format-win && npm run test:lint && npm run test:audit && npm run test:types && npm test-win",
    "test:audit": "npm audit --audit-level=moderate --production",
    "test:format": "prettier --check '**/*.{js,jsx,json,ts,tsx}'",
    "test:format-win": "prettier --check \"**/*.{js,jsx,json,ts,tsx}\"",
    "test:unit": "LLM_API_ENDPOINT=test-value ABE_SECRET_HEADER_NAME=test-value ABE_SECRET_HEADER_VALUE=test-value npx jest --config=./jest.config.js",
    "test:lint": "eslint . --ext ts --ext js --max-warnings=23",
    "test:types": "tsc --noEmit",
    "license:deploy": "license-check-and-add remove -f license-config.json && license-check-and-add add -f $LICENSE_CONFIG",
    "license:fix": "license-check-and-add remove -f license-config.json && license-check-and-add add -f license-config.json",
    "test:license": "license-check-and-add check -f license-config.json",
    "test:remove-license": "license-check-and-add remove -f license-config.json"
  },
  "dependencies": {
    "@azure/openai": "^2.0.0",
    "@google/generative-ai": "^0.24.1",
    "@jupyterlab/nbformat": "^3.6.3",
    "@types/chai": "^4.3.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/supertest": "^2.0.12",
    "@vendia/serverless-express": "^4.10.1",
    "@xapi/cmi5": "^1.1.6",
    "ajv": "^8.11.0",
    "aws-lambda": "^1.0.7",
    "axios": "^1.6.7",
    "base64url": "^3.0.1",
    "chai": "^4.3.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "express-graphql": "^0.12.0",
    "graphql-type-json": "^0.3.2",
    "jest": "^30.2.0",
    "json5": "^2.2.3",
    "jsonschema": "^1.5.0",
    "jsonwebtoken": "^9.0.0",
    "mongo-cursor-pagination": "^8.1.3",
    "mongoose": "^8.2.0",
    "object-path": "^0.11.8",
    "openai": "^6.21.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.6",
    "uuid": "^13.0.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.134",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.13",
    "@types/mocha": "^10.0.1",
    "@types/object-path": "^0.11.4",
    "@types/sinon": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^5.60.0",
    "@typescript-eslint/parser": "^5.60.0",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "license-check-and-add": "^4.0.5",
    "mocha": "^10.2.0",
    "mongo-unit": "^3.3.0",
    "prettier": "^2.8.8",
    "serverless-domain-manager": "^7.0.2",
    "serverless-offline": "^13.0.0",
    "serverless-offline-ssm": "^6.2.0",
    "serverless-plugin-typescript": "^2.1.2",
    "serverless-prune-plugin": "^2.0.2",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.1",
    "tsconfig": "^7.0.0",
    "tsconfig-paths": "^4.2.0"
  },
  "author": "USC ICT",
  "license": "ISC"
}
